# ====================================================================================
def presentation_data():

    connect = sqlite3.connect("classes.db")
    pointer = connect.cursor()

    pointer.execute("DROP TABLE IF EXISTS classes;")

    pointer.execute("""
        CREATE TABLE IF NOT EXISTS classes (
            id		        INTEGER PRIMARY KEY
            course_name		VARCHAR(100) NOT NULL,
            grade_point_average	DOUBLE NOT NULL,
            units	        INTEGER NOT NULL
	    term		TEXT
        );
    """)

    # sample data
    sample_data = [
        ('Calculus 3', 3.5, 4, 'Fall 2026'),
        ('Physics 205', 3.2, 3, 'Fall 2026'),
        ('History 1B', 4, 3, 'Spring 2027'),
        ('Ethnic Studies', 3.2, 3, 'Summer 2026')
    ]

    pointer.executemany("""
        INSERT INTO classes (course_name, grade_point_average, units, term) VALUES (?, ?, ?, ?);
    """, sample_data)

    connect.commit()
    connect.close()

