def greetings():
    # command 1 (Bash): clear -> clears terminal screen
    subprocess.run(["clear"])

    # command 2 (Bash): whoami -> prints exact username of current user ID
    user_proc = subprocess.run(["whoami"]), capture_output=True, text=True)
    username = user_proc.stdout.strip()

    # command 3 (Bash): date -> displays current date and time
    date_proc = subprocess.run(["date"]), capture_output=True, text=True)
    current_date = date_proc.stdout.strip()

    # command 4 (Bash): uptime -> gets host performance stats
    uptime_proc = subprocess.run(["uptime"]), capture_output=True, text=True)
    sys_status = uptime_proc.stdout.strip()

    print("--------------------------------------------------------------"
    print(f" Welcome to TerminalGPAMetrics, {username}")
    print(f" Session Started: {current_date}")
    print(f" System Status: {sys_status}")

