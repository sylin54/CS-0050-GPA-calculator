def edit_data_table(connection, cursor):
    #command 8 (Bash): cp -> copies the database to create a backup file
    print("Saving data to backup file...")
    subprocess.run(["cp", "classes.db", "classes.db.bak"])

    change_method = input("Select an edit method (Add, Delete, or Change): ").strip.lower()

    # add method
    if change_method == "add":
        new_course = input("Enter course name: ")
        new_units = int(input("Enter units: "))
        new_grade = float(input(("Enter letter grade: "))
        new_term = input("Enter term: ")

        cursor.execute(
            "INSERT INTO classes (course_name, units, grade_point_average, term) VALUES (?, ?, ?, ?);",
            (new_course, new_units, new_grade, new_term)
        )
        connection.commit()
        print("Course successfully added!")

    # delete method
    elif change_method == "delete":
        delete_target = input("Enter the course name you want to remove: ")

        cursor.execute(
            "DELETE FROM classes WHERE course_name = ?;", (delete_target)
        )
        connection.commit()
        print("Course successfully removed!")

    # change method
    elif change_method == "change":
        update_target = input("Enter the course name you want to update: ")
        update_field = input("Which field do you want to change (Grade, Units, or Term)?: ").strip().lower()
        new_value = input("Enter the new value: ")

        #updating fild based on users update field selection
        if update_field == "grade":
            cursor.execute("UPDATE classes SET grade_point_average = ? WHERE course_name = ?;", (float(new_value), update_target))
        elif update_field == "units":
            cursor.execute("UPDATE classes SET units = ? WHERE course_name = ?;", (int(new_value), update_target))
        elif update_field == "term":
            cursor.execute("UPDATE classes SET term = ? WHERE course_name = ?;", (new_value, update_target))
	else:
	    print("Invalid field selection.")
	    return

        connection.commit()
        print("Course sucessfully updated!")

    else:
        print("Invalid edit method selection.")

